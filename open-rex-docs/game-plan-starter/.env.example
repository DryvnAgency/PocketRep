# OpenRex Game Plan — env template.
# Paste real values into Vercel + Supabase secrets. Helper detects
# "PLACEHOLDER" substring and falls each integration back to its
# mock path (see lib/env.ts in the new repo).

# ---- Supabase (new project, provisioned in Section 4) -------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# ---- Gemini (LLM for message generation + autonomy classifier) ---------
GEMINI_API_KEY=

# ---- Twilio (account creds; per-dealership Messaging Service SID lives
#               on the tenants row, not here) ----------------------------
TWILIO_ACCOUNT_SID=AC_PLACEHOLDER_PASTE_REAL_SID
TWILIO_AUTH_TOKEN=PLACEHOLDER_PASTE_REAL_TOKEN

# ---- Stripe (dealership-tier subscription, single price) ---------------
STRIPE_SECRET_KEY=sk_PLACEHOLDER_PASTE_REAL_KEY
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER_PASTE_REAL_KEY
STRIPE_PRICE_DEALERSHIP=price_PLACEHOLDER

# ---- Versioning (passed into parser_events for selector drift detection)
EXTENSION_MIN_VERSION=0.1.0
PARSER_VERSION=2025-04

# ---- App URLs ----------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://app.example.com
