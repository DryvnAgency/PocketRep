EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_AI_PROXY_URL=https://your-project.supabase.co/functions/v1/ai-proxy
# Reserved for a future wake-word / voice provider (not currently used):
# EXPO_PUBLIC_VOICE_PROVIDER_KEY=

# v2 UI feature flag — set to "1" on the Vercel project that hosts the new
# Expo Web build (currently `project-t90u1`). Unset/omitted means users see
# the existing v1 UI. Native EAS builds intentionally leave this unset until
# the cutover PR. On web, runtime `?v=2` URL param also forces v2.
EXPO_PUBLIC_NEW_UI=

# Vehicle Finder (P2-V1) — default off. When "1", the rep can save their
# dealership website (Profile → Dealership website) and match customer notes to
# live inventory via a 🚗 modal + a Rex `find_vehicles` action. Also requires
# the `inventory-search` edge function to be deployed (committed but NOT
# deployed). Activation = set in BOTH eas.json (native) AND vercel.json
# build.env (web); do NOT set here in this PR.
EXPO_PUBLIC_VEHICLE_FINDER=

# Rex triad (P3-A1) — default off. When "1" (and EXPO_PUBLIC_REX_CHAT is on), the
# gold-orb coach chat runs a two-pass planner→executor pipeline instead of one
# call. Server-side model routing is honored only after ai-proxy is redeployed
# and BRAIN_MODELS_PLANNER / BRAIN_MODELS_EXECUTOR / BRAIN_MODELS_PARSER are set
# in the ai-proxy env (else both passes ride the default BRAIN_MODELS). Any
# planner-parse failure silently falls back to the single-call path. Activation =
# set in BOTH eas.json AND vercel.json build.env; do NOT set here in this PR.
EXPO_PUBLIC_REX_TRIAD=
