EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_AI_PROXY_URL=https://your-project.supabase.co/functions/v1/ai-proxy
# Reserved for a future wake-word / voice provider (not currently used):
# EXPO_PUBLIC_VOICE_PROVIDER_KEY=

# v2 UI feature flag — set to "1" on the Vercel project that hosts the new
# Expo Web build (currently `project-t90u1`). Unset/omitted means users see
# the existing v1 UI. Native EAS builds intentionally leave this unset until
# the cutover PR. On web, runtime `?v=2` URL param also forces v2.
EXPO_PUBLIC_NEW_UI=
