{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "EXPO_PUBLIC_REX_CHAT": "1",
      "EXPO_PUBLIC_CONTACT_IMPORT": "1",
      "EXPO_PUBLIC_REX_ONBOARDING": "1"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
