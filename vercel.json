{
  "outputDirectory": "Pocketrep",
  "redirects": [
    { "source": "/admin", "destination": "https://app.pocketrep.pro", "permanent": false },
    { "source": "/app", "destination": "https://app.pocketrep.pro", "permanent": false },
    { "source": "/app/(.*)", "destination": "https://app.pocketrep.pro/$1", "permanent": false }
  ],
  "rewrites": [
    { "source": "/thank-you", "destination": "/thankyou.html" },
    { "source": "/thankyou", "destination": "/thankyou.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/cancel", "destination": "/cancel.html" },
    { "source": "/car-sales-follow-up-software", "destination": "/car-sales-follow-up-software.html" },
    { "source": "/car-sales-follow-up-text-templates", "destination": "/car-sales-follow-up-text-templates.html" },
    { "source": "/crm-for-car-salespeople", "destination": "/crm-for-car-salespeople.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.+)\\.(js|woff2|ttf|eot|svg|png|jpg|webp)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(brand|seo-pages)\\.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
