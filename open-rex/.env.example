# Copy to backend/.env.local and fill in.

# Supabase (create a NEW project for Open Rex — do not reuse Rex Lens project)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — get a free key at https://aistudio.google.com/apikey
# Free tier: ~15 requests/min, ~1M tokens/day on gemini-2.5-flash. Plenty for
# dealer-pilot volume. Upgrade to paid or swap providers (see README "LLM
# provider") only when pilot outgrows it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Twilio — fill in after 10DLC brand/campaign approved
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Dealer alert number (where appointment notifications go)
DEALER_ALERT_PHONE=

# Dashboard auth (simple shared secret for MVP; replace with real auth post-MVP)
DASHBOARD_AUTH_SECRET=
