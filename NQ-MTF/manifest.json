{
  "manifest_version": 3,
  "name": "NQ-MTF",
  "version": "3.4",
  "description": "NQ futures multi-timeframe overlay for WealthCharts",
  "content_scripts": [
    {
      "matches": ["*://*.wealthcharts.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.wealthcharts.com/*"],
      "js": ["overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
